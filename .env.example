# ─── ZeroClaw AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal Access Token với quyền: repo, workflow, admin:repo_hook
# Tạo tại: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# ─── Slack ────────────────────────────────────────────────────────────────────
# App Token (xapp-...) - Tạo tại: https://api.slack.com/apps > Socket Mode
SLACK_APP_TOKEN=xapp-...
# Bot Token (xoxb-...) - Tạo tại: https://api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...

# ─── Notion ───────────────────────────────────────────────────────────────────
# Integration Token - Tạo tại: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...

# ─── Jira ─────────────────────────────────────────────────────────────────────
# Jira Cloud URL
JIRA_URL=https://your-company.atlassian.net
# Email đăng nhập Jira
JIRA_USERNAME=your-email@company.com
# API Token - Tạo tại: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=...
